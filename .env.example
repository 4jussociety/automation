# Google Gemini API Key
# 발급처: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (선택) 네이버 검색 API를 활용할 경우 (없으면 RSS 및 구글 뉴스 기반으로 자동 동작)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) 인스타그램 예약 및 브라우저 설정
INSTAGRAM_SCHEDULE_DEFAULT_HOUR=20
INSTAGRAM_HEADLESS=false

# (선택) 유튜브 쇼츠 업로드 설정
YOUTUBE_DEFAULT_PRIVACY=public
