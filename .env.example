# 이 파일은 환경 변수(.env) 설정 템플릿입니다.
# 네이버 검색, OpenAI, YouTube Data API, Instagram Graph API 인증 정보를 정의합니다.

# 1. 네이버 뉴스 검색 API
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# 2. OpenAI API 설정
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 3. Instagram Graph API 설정 (Meta for Developers)
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# 4. YouTube Data API v3 OAuth 설정
YOUTUBE_CLIENT_SECRET_FILE="client_secret.json"

# 5. GitHub 원격 저장소 설정 (인스타그램 이미지/비디오 공개 URL용)
GITHUB_REPO="4jussociety/automation"
GITHUB_BRANCH="main"
PUBLISH_HOUR_KST=8
