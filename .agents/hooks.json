{
  "automation-pre-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "py ../scripts/hooks/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}